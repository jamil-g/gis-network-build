# Copy to a file named .env and update as needed
POSTGRES_USER=gis_admin
POSTGRES_PASSWORD=gis_password
POSTGRES_DB=network_db
POSTGRES_PORT=5432

DATABASE_URL=postgresql://gis_admin:gis_password@localhost:5432/network_db

# Geocoding for the route-query CLI/API (turns an address into coordinates).
# "nominatim" needs no key and works out of the box. "google" needs a key
# (https://developers.google.com/maps/documentation/geocoding/get-api-key).
GEOCODING_PROVIDER=nominatim
GOOGLE_MAPS_API_KEY=

# Reference router for route-correct (validates/actively corrects our own routes
# against a trusted external router - see CLAUDE.md for why this design).
# Default is a community multi-profile OSRM demo, set to "foot". The other
# well-known public demo, router.project-osrm.org, is driving-only and silently
# ignores any other profile rather than erroring - avoid pointing OSRM_BASE_URL
# there unless OSRM_PROFILE is "driving".
OSRM_BASE_URL=https://routing.openstreetmap.de/routed-foot
OSRM_PROFILE=foot
